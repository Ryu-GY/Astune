APP_NAME=Astune API
APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8000
APP_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
ASTRO_CATALOG_PATH=../data/astro/bright-stars.json
ASTRO_EPHEMERIS_PATH=data/astro/de421.bsp
# Catalog version/source are read from the verified bright-stars.meta.json.
CITY_DATA_PATH=../data/locations/cities.json
DEFAULT_TIMEZONE=Asia/Seoul
LOCATION_CACHE_TTL_SECONDS=86400
LOCATION_CACHE_MAX_SIZE=2048
# City search uses Open-Meteo for cities outside the local dictionary (non-commercial free endpoint).
# Also requires allow_external=true on an explicit POST search; never on autocomplete GET.
GEOCODER_ENABLED=true
GEOCODER_URL=https://geocoding-api.open-meteo.com/v1/search
GEOCODER_USER_AGENT=Astune/0.1 (+https://github.com/Ryu-GY/Astune)
GEOCODER_TIMEOUT_SECONDS=5
