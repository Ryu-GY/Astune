NEXT_PUBLIC_APP_NAME=Astune
ASTUNE_ASTRO_API_URL=http://127.0.0.1:8000
ASTUNE_RULE_SOURCE=builtin
DATABASE_URL=file:./dev.db
ADMIN_BOOTSTRAP_EMAIL=admin@astune.local
# Development-only header authentication is disabled unless explicitly enabled.
ASTUNE_ALLOW_DEV_AUTH=0
# Optional raster map provider override; default uses the OpenStreetMap standard tiles.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
