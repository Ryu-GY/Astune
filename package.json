{
  "name": "astune",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "node scripts/prisma.mjs generate && next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:api": "node scripts/check-api-contract.mjs",
    "test:integration": "node --import tsx --test tests/storage-permissions.integration.test.ts",
    "verify": "node scripts/verify-tests.mjs",
    "db:generate": "node scripts/prisma.mjs generate",
    "db:push": "npm run db:migrate",
    "db:migrate": "node --env-file-if-exists=.env scripts/prepare-sqlite.mjs && node scripts/prisma.mjs migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "backend:sync": "uv sync --project astune-backend",
    "backend:data": "uv run --directory astune-backend python -m app.astro.prepare_data",
    "backend:check": "uv run --directory astune-backend python -m app.astro.check_data",
    "benchmark:preview": "node scripts/benchmark-preview.mjs",
    "backend:catalog": "uv run --directory astune-backend python -m app.astro.build_bright_catalog",
    "backend:dev": "uv run --directory astune-backend uvicorn app.main:app --host 127.0.0.1 --port 8000 --no-access-log",
    "backend:test": "uv run --directory astune-backend pytest",
    "db:transfer": "node --env-file=.env --import tsx scripts/database-transfer.ts",
    "admin:grant": "node --env-file=.env --import tsx scripts/grant-admin.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "better-auth": "^1.7.7",
    "leaflet": "1.9.4",
    "luxon": "^3.7.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@types/leaflet": "1.9.21",
    "@types/luxon": "^3.7.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prisma": "^6.19.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "@prisma/config": { "deepmerge-ts": "8.0.2" }
  }
}
