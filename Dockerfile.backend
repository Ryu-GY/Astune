FROM ghcr.io/astral-sh/uv:0.11.6 AS uv
FROM python:3.11-slim
COPY --from=uv /uv /usr/local/bin/uv
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy
WORKDIR /app/astune-backend
COPY astune-backend/pyproject.toml astune-backend/uv.lock astune-backend/README.md ./
RUN uv sync --locked --no-dev
COPY astune-backend/app ./app
COPY data /app/data
RUN uv run --no-sync python -m app.astro.prepare_data && uv run --no-sync python -m app.astro.check_data
RUN useradd --uid 10001 --create-home astune && chown -R astune:astune /app
USER astune
ENV APP_ENV=production APP_HOST=0.0.0.0 PORT=8000 TIMEZONEFINDER_IN_MEMORY=false
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=120s CMD .venv/bin/python -c "import os,urllib.request; urllib.request.urlopen('http://127.0.0.1:'+os.environ.get('PORT','8000')+'/ready', timeout=4)"
CMD ["sh", "-c", "exec .venv/bin/uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000} --workers 1 --no-access-log"]
